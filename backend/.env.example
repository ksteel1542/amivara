# AMIVARA API: copy to .env for local development. Never commit real values.
# In staging/prod these come from AWS Secrets Manager (af-south-1).

NODE_ENV=development
PORT=4000

# PostgreSQL 16 + PostGIS
DATABASE_URL=postgresql://amivara:amivara@localhost:5432/amivara?schema=public

# Redis (cache, queues, presence)
REDIS_URL=redis://localhost:6379

# AWS
AWS_REGION=af-south-1
S3_MEDIA_BUCKET=
CLOUDFRONT_MEDIA_DOMAIN=

# Smile ID (KYC, SmartSelfie liveness). Use the sandbox until launch.
SMILE_ID_ENVIRONMENT=sandbox
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_CALLBACK_URL=
