{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "AMIVARA ROSE design tokens v1.0 (approved 2026-11-10). Single source of truth for Flutter (Material 3) and Next.js. Human-readable guidelines: design/brand/AMIVARA_ROSE.md. Contrast ratios are WCAG 2.x, measured.",
  "$extensions": {
    "com.amivara.meta": {
      "name": "AMIVARA ROSE",
      "version": "1.0.0",
      "status": "approved",
      "approvedOn": "2026-11-10",
      "material3": { "dynamicColor": false }
    }
  },

  "color": {
    "$type": "color",
    "core": {
      "$description": "Approved AMIVARA ROSE core palette.",
      "deep-rose":      { "$value": "#88304E", "$description": "Primary (Deep Rose): primary actions and brand moments, light mode only." },
      "burgundy":       { "$value": "#52182F", "$description": "Secondary (Burgundy): headings on light, onboarding hero." },
      "champagne-gold": { "$value": "#D4AF37", "$description": "Accent (Champagne Gold): verified badge, highlights. Decoration only on light backgrounds (2.03:1 on ivory)." },
      "warm-ivory":     { "$value": "#FDFBF7", "$description": "Canvas, light mode." },
      "burgundy-black": { "$value": "#1A0B12", "$description": "Canvas, dark mode (Deep Burgundy-Black)." }
    },

    "palette": {
      "$description": "Extended scale, including the accessibility-derived tones.",
      "rose": {
        "100": { "$value": "#F9DCE5" },
        "300": { "$value": "#E8A5BC", "$description": "Primary in dark mode (9.58:1 on night). Deep Rose fails there (2.34:1)." },
        "700": { "$value": "{color.core.deep-rose}" },
        "800": { "$value": "#6A2440" },
        "950": { "$value": "#3A0A1C" }
      },
      "burgundy": {
        "200": { "$value": "#E3BCC9" },
        "900": { "$value": "{color.core.burgundy}" },
        "950": { "$value": "#2E0A18" }
      },
      "gold": {
        "500": { "$value": "{color.core.champagne-gold}" },
        "700": { "$value": "#8A6D12", "$description": "Deep Gold: gold text and icons on light backgrounds (4.75:1 on ivory)." }
      },
      "ivory": {
        "50":  { "$value": "{color.core.warm-ivory}" },
        "100": { "$value": "#F6F0E8" }
      },
      "night": {
        "800": { "$value": "#2A1520", "$description": "Raised surfaces in dark mode." },
        "950": { "$value": "{color.core.burgundy-black}" }
      },
      "ink": {
        "600": { "$value": "#6B5A60", "$description": "Secondary text on light (6.24:1 on ivory)." },
        "900": { "$value": "#2A1A20", "$description": "Body text on light (16.04:1 on ivory)." }
      },
      "mist": {
        "50":  { "$value": "#F5ECEF", "$description": "Body text on dark (16.47:1 on night)." },
        "300": { "$value": "#BFAEB4", "$description": "Secondary text on dark (9.02:1 on night)." }
      },
      "line": {
        "light": { "$value": "#E7DCD3" },
        "dark":  { "$value": "#3D2430" }
      },
      "white": { "$value": "#FFFFFF" }
    },

    "status": {
      "success": {
        "light": { "$value": "#2E7D5B", "$description": "4.84:1 on ivory" },
        "dark":  { "$value": "#7FD1AE", "$description": "10.57:1 on night" }
      },
      "warning": {
        "light": { "$value": "#965C09", "$description": "5.30:1 on ivory" },
        "dark":  { "$value": "#F2C46D", "$description": "11.71:1 on night" }
      },
      "error": {
        "light": { "$value": "#B3261E", "$description": "6.32:1 on ivory" },
        "dark":  { "$value": "#F2B8B5", "$description": "11.18:1 on night" },
        "on-dark": { "$value": "#601410" }
      }
    },

    "scheme": {
      "$description": "Material 3 ColorScheme role mapping.",
      "light": {
        "primary":            { "$value": "{color.core.deep-rose}" },
        "onPrimary":          { "$value": "{color.palette.white}" },
        "primaryContainer":   { "$value": "{color.palette.rose.100}" },
        "onPrimaryContainer": { "$value": "{color.palette.rose.950}" },
        "secondary":          { "$value": "{color.core.burgundy}" },
        "onSecondary":        { "$value": "{color.palette.white}" },
        "tertiary":           { "$value": "{color.palette.gold.700}" },
        "onTertiary":         { "$value": "{color.palette.white}" },
        "surface":            { "$value": "{color.core.warm-ivory}" },
        "onSurface":          { "$value": "{color.palette.ink.900}" },
        "surfaceContainer":   { "$value": "{color.palette.ivory.100}" },
        "onSurfaceVariant":   { "$value": "{color.palette.ink.600}" },
        "outline":            { "$value": "{color.palette.line.light}" },
        "error":              { "$value": "{color.status.error.light}" },
        "onError":            { "$value": "{color.palette.white}" }
      },
      "dark": {
        "primary":            { "$value": "{color.palette.rose.300}" },
        "onPrimary":          { "$value": "{color.core.burgundy-black}" },
        "primaryContainer":   { "$value": "{color.palette.rose.800}" },
        "onPrimaryContainer": { "$value": "#FFD9E3" },
        "secondary":          { "$value": "{color.palette.burgundy.200}" },
        "onSecondary":        { "$value": "{color.palette.burgundy.950}" },
        "tertiary":           { "$value": "{color.core.champagne-gold}" },
        "onTertiary":         { "$value": "{color.core.burgundy-black}" },
        "surface":            { "$value": "{color.core.burgundy-black}" },
        "onSurface":          { "$value": "{color.palette.mist.50}" },
        "surfaceContainer":   { "$value": "{color.palette.night.800}" },
        "onSurfaceVariant":   { "$value": "{color.palette.mist.300}" },
        "outline":            { "$value": "{color.palette.line.dark}" },
        "error":              { "$value": "{color.status.error.dark}" },
        "onError":            { "$value": "{color.status.error.on-dark}" }
      }
    },

    "brand": {
      "verified-badge": {
        "fill":  { "$value": "{color.core.champagne-gold}", "$description": "Reserved: only for members whose Smile ID verification passed." },
        "check": { "$value": "{color.core.burgundy-black}", "$description": "9.07:1 on gold" }
      },
      "hero-background": { "$value": "{color.core.burgundy}" }
    }
  },

  "accessibility": {
    "$description": "Accessibility rules and measured contrast pairs. Lint tooling should fail if any 'pass' pair drops below its required ratio.",
    "minContrast": {
      "$type": "number",
      "text-normal":   { "$value": 4.5 },
      "text-large":    { "$value": 3.0 },
      "ui-component":  { "$value": 3.0 }
    },
    "touchTarget": {
      "$type": "dimension",
      "min": { "$value": { "value": 48, "unit": "px" }, "$description": "48dp minimum interactive size." }
    },
    "maxFontScale": { "$type": "number", "$value": 2.0 },
    "goldMaxScreenShare": { "$type": "number", "$value": 0.05, "$description": "Gold should cover no more than ~5% of any screen." },
    "$extensions": {
      "com.amivara.contrast": {
        "pass": [
          { "fg": "#FFFFFF", "bg": "#88304E", "ratio": 8.14,  "use": "Primary button label (light)" },
          { "fg": "#88304E", "bg": "#FDFBF7", "ratio": 7.88,  "use": "Links and text buttons (light)" },
          { "fg": "#52182F", "bg": "#FDFBF7", "ratio": 13.28, "use": "Headings (light)" },
          { "fg": "#2A1A20", "bg": "#FDFBF7", "ratio": 16.04, "use": "Body text (light)" },
          { "fg": "#6B5A60", "bg": "#FDFBF7", "ratio": 6.24,  "use": "Secondary text (light)" },
          { "fg": "#6B5A60", "bg": "#F6F0E8", "ratio": 5.70,  "use": "Secondary text on card (light)" },
          { "fg": "#8A6D12", "bg": "#FDFBF7", "ratio": 4.75,  "use": "Gold text and icons (light)" },
          { "fg": "#FFFFFF", "bg": "#8A6D12", "ratio": 4.91,  "use": "Label on tertiary (light)" },
          { "fg": "#3A0A1C", "bg": "#F9DCE5", "ratio": 13.22, "use": "On primary container (light)" },
          { "fg": "#D4AF37", "bg": "#52182F", "ratio": 6.53,  "use": "Gold on burgundy hero" },
          { "fg": "#1A0B12", "bg": "#D4AF37", "ratio": 9.07,  "use": "Verified badge check / gold chip label" },
          { "fg": "#D4AF37", "bg": "#1A0B12", "ratio": 9.07,  "use": "Gold accent (dark)" },
          { "fg": "#1A0B12", "bg": "#E8A5BC", "ratio": 9.58,  "use": "Primary button label (dark)" },
          { "fg": "#E8A5BC", "bg": "#1A0B12", "ratio": 9.58,  "use": "Primary text and links (dark)" },
          { "fg": "#E8A5BC", "bg": "#2A1520", "ratio": 8.59,  "use": "Primary on card (dark)" },
          { "fg": "#FFD9E3", "bg": "#6A2440", "ratio": 8.40,  "use": "On primary container (dark)" },
          { "fg": "#E3BCC9", "bg": "#1A0B12", "ratio": 11.18, "use": "Secondary (dark)" },
          { "fg": "#F5ECEF", "bg": "#1A0B12", "ratio": 16.47, "use": "Body text (dark)" },
          { "fg": "#BFAEB4", "bg": "#1A0B12", "ratio": 9.02,  "use": "Secondary text (dark)" },
          { "fg": "#BFAEB4", "bg": "#2A1520", "ratio": 8.09,  "use": "Secondary text on card (dark)" },
          { "fg": "#2E7D5B", "bg": "#FDFBF7", "ratio": 4.84,  "use": "Success (light)" },
          { "fg": "#965C09", "bg": "#FDFBF7", "ratio": 5.30,  "use": "Warning (light)" },
          { "fg": "#B3261E", "bg": "#FDFBF7", "ratio": 6.32,  "use": "Error (light)" }
        ],
        "forbidden": [
          { "fg": "#D4AF37", "bg": "#FDFBF7", "ratio": 2.03, "rule": "Champagne Gold is never text on light. Use gold-700 #8A6D12." },
          { "fg": "#88304E", "bg": "#1A0B12", "ratio": 2.34, "rule": "Deep Rose is never used in dark mode. Use rose-300 #E8A5BC." },
          { "fg": "#D4AF37", "bg": "#88304E", "ratio": null, "rule": "Gold on rose clashes. Not allowed." }
        ]
      }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "display":           { "$value": ["Playfair Display", "Georgia", "serif"], "$description": "Primary editorial face. Headlines only." },
      "display-alternate": { "$value": ["Cormorant Garamond", "Georgia", "serif"], "$description": "Large editorial moments only (36sp and up). Not bundled in the app by default." },
      "body":              { "$value": ["Inter", "system-ui", "Roboto", "sans-serif"], "$description": "Primary UI and body face." },
      "body-alternate":    { "$value": ["Plus Jakarta Sans", "system-ui", "Roboto", "sans-serif"], "$description": "Alternate UI face, for A/B testing only." }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 }
    },
    "$extensions": {
      "com.amivara.delivery": {
        "android": "Bundle subset variable TTFs (Latin + Latin Extended, covering Yoruba/Igbo/Hausa diacritics). Do not use google_fonts runtime fetching.",
        "web": "next/font/google, display: swap, self-hosted at build time.",
        "license": "SIL Open Font License 1.1 (all four families)",
        "bundledInApp": ["Playfair Display", "Inter"]
      }
    }
  },

  "typography": {
    "$type": "typography",
    "$description": "Material 3 type roles. Sizes are in sp on Android and px on web. letterSpacing is in em.",
    "displayLarge":   { "$value": { "fontFamily": "{font.family.display}", "fontSize": { "value": 48, "unit": "px" }, "lineHeight": 1.1667, "fontWeight": 600, "letterSpacing": { "value": 0, "unit": "rem" } } },
    "displaySmall":   { "$value": { "fontFamily": "{font.family.display}", "fontSize": { "value": 36, "unit": "px" }, "lineHeight": 1.2222, "fontWeight": 600, "letterSpacing": { "value": 0, "unit": "rem" } } },
    "headlineLarge":  { "$value": { "fontFamily": "{font.family.display}", "fontSize": { "value": 32, "unit": "px" }, "lineHeight": 1.25,   "fontWeight": 600, "letterSpacing": { "value": 0, "unit": "rem" } } },
    "headlineMedium": { "$value": { "fontFamily": "{font.family.display}", "fontSize": { "value": 28, "unit": "px" }, "lineHeight": 1.2857, "fontWeight": 600, "letterSpacing": { "value": 0, "unit": "rem" } } },
    "headlineSmall":  { "$value": { "fontFamily": "{font.family.display}", "fontSize": { "value": 24, "unit": "px" }, "lineHeight": 1.3333, "fontWeight": 500, "letterSpacing": { "value": 0, "unit": "rem" } } },
    "titleLarge":     { "$value": { "fontFamily": "{font.family.body}",    "fontSize": { "value": 22, "unit": "px" }, "lineHeight": 1.2727, "fontWeight": 600, "letterSpacing": { "value": 0, "unit": "rem" } } },
    "titleMedium":    { "$value": { "fontFamily": "{font.family.body}",    "fontSize": { "value": 16, "unit": "px" }, "lineHeight": 1.5,    "fontWeight": 600, "letterSpacing": { "value": 0.009375, "unit": "rem" } } },
    "bodyLarge":      { "$value": { "fontFamily": "{font.family.body}",    "fontSize": { "value": 16, "unit": "px" }, "lineHeight": 1.5,    "fontWeight": 400, "letterSpacing": { "value": 0.03125, "unit": "rem" } } },
    "bodyMedium":     { "$value": { "fontFamily": "{font.family.body}",    "fontSize": { "value": 14, "unit": "px" }, "lineHeight": 1.4286, "fontWeight": 400, "letterSpacing": { "value": 0.015625, "unit": "rem" } } },
    "bodySmall":      { "$value": { "fontFamily": "{font.family.body}",    "fontSize": { "value": 12, "unit": "px" }, "lineHeight": 1.3333, "fontWeight": 400, "letterSpacing": { "value": 0.025, "unit": "rem" } } },
    "labelLarge":     { "$value": { "fontFamily": "{font.family.body}",    "fontSize": { "value": 14, "unit": "px" }, "lineHeight": 1.4286, "fontWeight": 600, "letterSpacing": { "value": 0.00625, "unit": "rem" } } },
    "labelMedium":    { "$value": { "fontFamily": "{font.family.body}",    "fontSize": { "value": 12, "unit": "px" }, "lineHeight": 1.3333, "fontWeight": 600, "letterSpacing": { "value": 0.03125, "unit": "rem" } } }
  },

  "spacing": {
    "$type": "dimension",
    "$description": "4dp base grid.",
    "1":  { "$value": { "value": 4,  "unit": "px" } },
    "2":  { "$value": { "value": 8,  "unit": "px" } },
    "3":  { "$value": { "value": 12, "unit": "px" } },
    "4":  { "$value": { "value": 16, "unit": "px" } },
    "6":  { "$value": { "value": 24, "unit": "px" } },
    "8":  { "$value": { "value": 32, "unit": "px" } },
    "12": { "$value": { "value": 48, "unit": "px" } },
    "16": { "$value": { "value": 64, "unit": "px" } },
    "gutter": {
      "onboarding": { "$value": "{spacing.6}", "$description": "24dp screen gutter in onboarding." },
      "dense":      { "$value": "{spacing.4}", "$description": "16dp in dense lists." }
    },
    "button": {
      "primary-height":    { "$value": { "value": 56, "unit": "px" } },
      "bottom-inset":      { "$value": "{spacing.6}" }
    }
  },

  "radius": {
    "$type": "dimension",
    "sm":   { "$value": { "value": 8,   "unit": "px" }, "$description": "Inputs, chips, OTP boxes" },
    "md":   { "$value": { "value": 16,  "unit": "px" }, "$description": "Cards, sheets" },
    "lg":   { "$value": { "value": 28,  "unit": "px" }, "$description": "Profile cards, hero media" },
    "full": { "$value": { "value": 999, "unit": "px" }, "$description": "Pill buttons, avatars, verified badge" }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "short":  { "$value": { "value": 150, "unit": "ms" }, "$description": "Taps, toggles" },
      "medium": { "$value": { "value": 300, "unit": "ms" }, "$description": "Screen transitions, sheets" },
      "long":   { "$value": { "value": 500, "unit": "ms" }, "$description": "Match celebration, verification success" }
    },
    "easing": {
      "$type": "cubicBezier",
      "emphasized":            { "$value": [0.2, 0.0, 0.0, 1.0] },
      "emphasized-decelerate": { "$value": [0.05, 0.7, 0.1, 1.0] },
      "emphasized-accelerate": { "$value": [0.3, 0.0, 0.8, 0.15] }
    }
  },

  "icon": {
    "$extensions": {
      "com.amivara.icon": {
        "set": "Material Symbols Rounded",
        "weight": 400,
        "grade": 0,
        "defaultStyle": "outlined",
        "activeStyle": "filled"
      }
    }
  }
}
